{
  "name": "dsh-large-proj-perf",
  "version": "1.10.1",
  "description": "DSH 大会话性能插件：turnOutline 折叠加速（冷读 21.2s → 3.0s）+ 事件缓存字节预算（RSS 1324 → 690 MB）+ 分片 materialize + 零拷贝 fork + heap 上限告警",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "prepublishOnly": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "scripts",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangeofcarl0-sys/dsh-large-proj-perf.git"
  },
  "bugs": {
    "url": "https://github.com/orangeofcarl0-sys/dsh-large-proj-perf/issues"
  },
  "homepage": "https://github.com/orangeofcarl0-sys/dsh-large-proj-perf#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fork",
    "projection",
    "performance",
    "materialize"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
